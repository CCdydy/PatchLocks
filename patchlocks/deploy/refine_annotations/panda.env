# Panda paper-refinement annotation.
INDIVIDUAL_ANNOTATION_JSON=patchlocks/deploy/refine_annotations/panda.json

# Final v16 character-consumption recipe.
# Panda keeps a longer fuzzy coat than tiger, but lift is slightly reduced so
# the fur remains bundled instead of wild.
V16_TARGET_ARCLEN=0.025
V16_STRAND_PROFILE_LIFT_SCALE=0.85
V16_V10_VOLUME_TARGET_ARCLEN=0.050
V16_V10_VOLUME_LIFT_SCALE=1.0

# Torso loft (partial-lift fluff): thickest/plushest coat of the set. ~50% of body
# strands stand up to cap (~0.5x length); cap tracks the longer 0.025 coat.
TORSO_LIFT_K=1.0
TORSO_LIFT_CAP=0.013
TORSO_LIFT_FRAC=0.50
TORSO_LIFT_MODE=smooth
TORSO_LIFT_SMOOTH_K=8
TORSO_LIFT_SMOOTH_ITERS=4

REGION_DETAIL_POLICY=generic
REGION_DETAIL_FEATHER=0.0

# Panda ears can keep more volume than tiger ears, but still need compact edges.
# Eased keep/scale so the neck (labeled ears+face) stays dense -- no bare skin.
REGION_DETAIL_EAR_SCALE=0.85
REGION_DETAIL_EAR_KEEP=0.97
REGION_DETAIL_EAR_BODY_CAP=0.82

# Legs/body seam: keep the bulky panda coat intact. Broad trimming made the coat too thin.
REGION_DETAIL_LEG_SCALE=1.0
REGION_DETAIL_LEG_KEEP=1.0
REGION_DETAIL_LEG_BODY_CAP=0.0
REGION_DETAIL_LEG_FEATHER=0.0

REGION_DETAIL_PAW_SCALE=0.60
REGION_DETAIL_PAW_KEEP=0.85
REGION_DETAIL_PAW_BODY_CAP=0.60
REGION_DETAIL_PAW_FEATHER=0.09

# Neck is mostly labeled face here; old cap=0.55 bared the skin. Eased so neck stays
# shorter than body (~0.78x) but dense.
REGION_DETAIL_FACE_SCALE=0.88
REGION_DETAIL_FACE_KEEP=0.97
REGION_DETAIL_FACE_BODY_CAP=0.78

TAIL_LENGTH_POLICY=uniform
TAIL_LENGTH_REGIONS=tail,tail_base
TAIL_LENGTH_BODY_CAP=0.90
TAIL_LENGTH_TIP_SCALE=0.90
TAIL_LENGTH_TIP_START_PCT=35
TAIL_LENGTH_TIP_END_PCT=98
TAIL_LENGTH_TIP_POW=1.5
