# Template recipe for a new animal (docs/NEW_ANIMAL.md). Copy to refine_annotations/<animal>.env,
# where run_locked_3animals.sh / pipeline/04 look for it, and calibrate it against the photos.
# Mesh units are those of the capture (metres for COLMAP captures with a metric mesh).

# Groom-level strand length (metres) and lift, the reconstruction-time inputs of the recipe.
# Calibrate the length with patchlocks/qa/silhouette_fur_thickness.py: grow with a guess and pick
# the length whose fur thickness beyond the furless silhouette matches the photos'.
V16_TARGET_ARCLEN=0.018
V16_STRAND_PROFILE_LIFT_SCALE=0.9
V16_V10_VOLUME_TARGET_ARCLEN=0.018
V16_V10_VOLUME_LIFT_SCALE=1.0

# Double coat: part of the body strands stand off the skin (cap ~ half the strand length).
TORSO_LIFT_K=1.0
TORSO_LIFT_CAP=0.009
TORSO_LIFT_FRAC=0.40
TORSO_LIFT_MODE=random

# Region labels: check the automatic ones on the photos first. If they are wrong, write rule-based
# labels with patchlocks/deploy/label_patch_regions.py and point a <animal>.json at them
# ({"animal": "<animal>", "patch_region_npz": "<animal>_patch_region.npz"}).
# INDIVIDUAL_ANNOTATION_JSON=patchlocks/deploy/refine_annotations/<animal>.json

# Density: 3M strands give a denser, smoother coat than the paper's 1.2M budget.
TARGET_STRANDS=3000000

# Step 3b: refine Step 2's per-patch length on the body and legs against the fur silhouettes of all
# capture views, two rounds. Set SILHOUETTE_LENGTH_EXCLUDE=accessory when the animal wears a collar
# (masks from patchlocks/deploy/segment_accessory_masks.py), so it is not taken for thicker fur.
SILHOUETTE_LENGTH_ITERS=2
SILHOUETTE_LENGTH_REGIONS=body,legs
SILHOUETTE_LENGTH_EXCLUDE=

# Short, close-lying fur on the muzzle, ears, legs and paws; body and tail keep the calibrated
# length. Adjust the scales by comparing renders with the photos at the capture cameras.
REGION_DETAIL_POLICY=generic
REGION_DETAIL_FEATHER=0.0
REGION_DETAIL_FACE_SCALE=0.60
REGION_DETAIL_FACE_KEEP=1.0
REGION_DETAIL_FACE_BODY_CAP=0.0
REGION_DETAIL_EAR_SCALE=0.55
REGION_DETAIL_EAR_KEEP=1.0
REGION_DETAIL_EAR_BODY_CAP=0.0
REGION_DETAIL_LEG_SCALE=0.65
REGION_DETAIL_LEG_KEEP=1.0
REGION_DETAIL_LEG_BODY_CAP=0.0
REGION_DETAIL_LEG_FEATHER=0.02
REGION_DETAIL_PAW_SCALE=0.45
REGION_DETAIL_PAW_KEEP=1.0
REGION_DETAIL_PAW_BODY_CAP=0.0
REGION_DETAIL_PAW_FEATHER=0.02
# tail: no cap and no distal taper
REGION_DETAIL_TAIL_BODY_CAP=0.0
REGION_DETAIL_TAIL_SCALE=1.0
REGION_DETAIL_TAIL_KEEP=1.0
TAIL_LENGTH_POLICY=none
