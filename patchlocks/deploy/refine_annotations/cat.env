# Cat paper-refinement annotation.
# NOTE: cat has no per-region (tail/ear/paw) annotation yet, so region-detail and
# tail-length policies are disabled here. The run uses a geometric region prior +
# honest image-flow Step2 (nf_data_walk_final_f0). Add an INDIVIDUAL_ANNOTATION_JSON
# later for per-region refinement.

# v16 character-consumption recipe. Cat = short/medium coat: start between beagle
# (0.0127) and whiteTiger (0.018); mild lift for a soft, body-hugging coat.
V16_TARGET_ARCLEN=0.016
V16_STRAND_PROFILE_LIFT_SCALE=0.9
V16_V10_VOLUME_TARGET_ARCLEN=0.018
V16_V10_VOLUME_LIFT_SCALE=1.0

# Torso loft (partial-lift fluff): short-medium coat, lightest fluff of the three
# lofted animals. ~35% of body strands stand up to a small cap (~0.5x length).
TORSO_LIFT_K=1.0
TORSO_LIFT_CAP=0.008
TORSO_LIFT_FRAC=0.35

REGION_DETAIL_POLICY=none
REGION_DETAIL_FEATHER=0.0
TAIL_LENGTH_POLICY=none
