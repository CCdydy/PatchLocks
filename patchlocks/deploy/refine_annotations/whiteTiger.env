# White tiger paper-refinement annotation.
# Keep this per-animal: it intentionally uses a fixed region annotation.
INDIVIDUAL_ANNOTATION_JSON=patchlocks/deploy/refine_annotations/whiteTiger.json

# Final v16 character-consumption recipe.
# The v16 prior gives clean direction/character; this absolute length keeps the
# white-tiger coat medium-short and avoids the old spiky V10 overgrowth.
V16_TARGET_ARCLEN=0.018
V16_STRAND_PROFILE_LIFT_SCALE=0.85
V16_V10_VOLUME_TARGET_ARCLEN=0.040
V16_V10_VOLUME_LIFT_SCALE=1.0

# Torso loft (partial-lift fluff): medium plush coat. ~45% of body strands stand up
# to cap (~0.5x length); the rest lie flat. cap tracks the 0.018 coat length.
TORSO_LIFT_K=1.0
TORSO_LIFT_CAP=0.010
TORSO_LIFT_FRAC=0.45

# Local part cleanup after Step2 flow/length fitting.
REGION_DETAIL_POLICY=generic
REGION_DETAIL_FEATHER=0.035

# Ears: compact and feather, but do not over-prune. (Neck patches are mislabeled
# ears/face, so over-pruning here thinned the neck -- eased keep/scale to add density back.)
REGION_DETAIL_EAR_SCALE=0.82
REGION_DETAIL_EAR_KEEP=0.97
REGION_DETAIL_EAR_BODY_CAP=0.82

# Legs/body seam: mild compacting plus wide feather to remove the skirt/cuff.
REGION_DETAIL_LEG_SCALE=0.88
REGION_DETAIL_LEG_KEEP=0.94
REGION_DETAIL_LEG_BODY_CAP=0.78
REGION_DETAIL_LEG_FEATHER=0.10

# Paws: already short; keep transition broad so it does not form a hard cuff.
REGION_DETAIL_PAW_SCALE=0.60
REGION_DETAIL_PAW_KEEP=0.85
REGION_DETAIL_PAW_BODY_CAP=0.60
REGION_DETAIL_PAW_FEATHER=0.09

# Face: compact muzzle/cheek fuzz; the fixed annotation prevents tail taper from hitting the head.
# Neck is mostly labeled face here, so keep/scale eased up to stop the neck reading sparse.
REGION_DETAIL_FACE_SCALE=0.90
REGION_DETAIL_FACE_KEEP=0.98
REGION_DETAIL_FACE_BODY_CAP=0.78

# Tail: fixed annotation + uniformized length + distal taper. This is the approved no-pom-pom route.
REGION_DETAIL_TAIL_BODY_CAP=0.80
REGION_DETAIL_TAIL_UNIFORM_SCALE=1.0
REGION_DETAIL_TAIL_UNIFORM_KEEP=0.65
REGION_DETAIL_TAIL_METRIC=base_dist
REGION_DETAIL_TAIL_TAPER_POW=1.0
REGION_DETAIL_TAIL_KEEP_POW=1.5
REGION_DETAIL_TAIL_TIP_KEEP=0.15
TAIL_LENGTH_POLICY=uniform
TAIL_LENGTH_REGIONS=tail,tail_base
TAIL_LENGTH_BODY_CAP=0.85
TAIL_LENGTH_TIP_SCALE=0.45
TAIL_LENGTH_TIP_START_PCT=30
TAIL_LENGTH_TIP_END_PCT=98
TAIL_LENGTH_TIP_POW=1.6
