# Beagle paper-refinement annotation.
INDIVIDUAL_ANNOTATION_JSON=patchlocks/deploy/refine_annotations/beagle.json

# Final v16 character-consumption recipe.
# Keep the short single-direction coat: v16 already lands at this short-hair
# scale without extra lift correction.
V16_TARGET_ARCLEN=0.0127
V16_STRAND_PROFILE_LIFT_SCALE=1.0
V16_V10_VOLUME_TARGET_ARCLEN=0.025
V16_V10_VOLUME_LIFT_SCALE=1.0

# Torso loft: OFF. Beagle's short smooth coat already reads best as-is (v16-final);
# no partial-lift fluffing wanted here.
TORSO_LIFT_K=0.0

REGION_DETAIL_POLICY=generic
REGION_DETAIL_FEATHER=0.0

# Ears/face: neck is mostly labeled ears+face here, so the old aggressive
# face_body_cap=0.45 (neck only ~1/3 of body length) bared the skin. Eased so the
# neck stays SHORTER than body (~0.78x) but dense enough to cover skin.
REGION_DETAIL_EAR_SCALE=0.88
REGION_DETAIL_EAR_KEEP=0.97
REGION_DETAIL_EAR_BODY_CAP=0.82
REGION_DETAIL_FACE_SCALE=0.88
REGION_DETAIL_FACE_KEEP=0.97
REGION_DETAIL_FACE_BODY_CAP=0.78

# Legs/body seam: keep body coat intact. Earlier broad feathering made the dog look sparse.
REGION_DETAIL_LEG_SCALE=1.0
REGION_DETAIL_LEG_KEEP=1.0
REGION_DETAIL_LEG_BODY_CAP=0.0
REGION_DETAIL_LEG_FEATHER=0.0

REGION_DETAIL_PAW_SCALE=0.55
REGION_DETAIL_PAW_KEEP=0.85
REGION_DETAIL_PAW_BODY_CAP=0.55
REGION_DETAIL_PAW_FEATHER=0.09

TAIL_LENGTH_POLICY=uniform
TAIL_LENGTH_REGIONS=tail,tail_base
TAIL_LENGTH_BODY_CAP=0.85
TAIL_LENGTH_TIP_SCALE=0.90
TAIL_LENGTH_TIP_START_PCT=35
TAIL_LENGTH_TIP_END_PCT=98
TAIL_LENGTH_TIP_POW=1.5
